# ================= 用户端网页（travel-web）=================
FROM node:20-alpine AS web
WORKDIR /app
COPY travel-web/package*.json ./
RUN npm install --no-audit --no-fund
COPY travel-web/ ./
RUN npm run build

# ================= 管理后台（travel-admin）=================
FROM node:20-alpine AS admin
WORKDIR /app
COPY travel-admin/package*.json ./
RUN npm install --no-audit --no-fund
COPY travel-admin/ ./
# 后台挂在 /admin/ 子路径下，构建时指定 base
RUN npm run build -- --base=/admin/

# ================= 网关：Nginx（静态资源 + 反向代理 + 限流）=================
FROM nginx:1.27-alpine

COPY deploy/nginx/conf.d/travel.conf /etc/nginx/conf.d/default.conf

COPY --from=web /app/dist /usr/share/nginx/html/web
COPY --from=admin /app/dist /usr/share/nginx/html/admin

EXPOSE 80
