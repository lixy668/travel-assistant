# 复制这个文件为 .env（同一目录下），把值换成你自己的，然后 docker compose up -d --build
# .env 里有密钥，不要提交到 git、不要发群里

# MySQL root 密码（容器里新建的库用它；和本机 3306 那个 MySQL 互不影响）
MYSQL_PASSWORD=2003

# JWT 签名密钥：随便一串 32 位以上随机字符
JWT_SECRET=change-me-to-a-random-32-chars-secret

# DeepSeek（AI 对话 / 行程规划）
DEEPSEEK_API_KEY=sk-你的key

# 高德地图 Web 服务 Key（酒店 / 景点真实数据）
AMAP_KEY=你的高德key

# 允许跨域的来源：用域名访问就写 https://你的域名，多个用逗号隔开；本地保持 *
CORS_ALLOWED_ORIGINS=*
